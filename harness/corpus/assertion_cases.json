    { "id": "output_not_contains/empty-needle", "fr": "003-FR-004",
      "assertion": {"type": "output_not_contains", "value": ""} },
    { "id": "screen_contains/present", "fr": "003-FR-004",
      "assertion": {"type": "screen_contains", "value": "SCREEN"} },
    { "id": "screen_contains/absent", "fr": "003-FR-004",
      "assertion": {"type": "screen_contains", "value": "zzz"} },
