      "assertion": {"type": "screen_not_contains", "value": "SCREEN"} },
    { "id": "screen_not_contains/empty-needle", "fr": "003-FR-004",
      "assertion": {"type": "screen_not_contains", "value": ""} },
    { "id": "output_contains/multiline-haystack", "fr": "003-FR-004",
